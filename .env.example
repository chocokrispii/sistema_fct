# Entorno local de desarrollo con Docker Compose. Cambia estas claves antes de compartir el entorno.
# Puertos alternativos para no interferir con otros proyectos locales.
APP_PORT=18080
APP_ENV=development
COMPOSE_PROFILES=dev
# Solo omite el análisis durante desarrollo local; en otros entornos se rechaza.
FCT_CLAMAV_ENABLED=false
PMA_PORT=18083
DB_PORT=13308
CLAMAV_PORT=13311
FCT_DB_NAME=sistema_fct
FCT_DB_USER=fct
FCT_DB_PASS=fct_local_dev
MARIADB_ROOT_PASSWORD=root_local_dev
FCT_VITE_DEV_SERVER=
VITE_PORT=15174
FCT_WEBHOOK_INBOUND_SECRET=
FCT_WEBHOOK_OUTBOUND_URL=
FCT_WEBHOOK_OUTBOUND_SECRET=
FCT_PUBLIC_BASE_URL=http://localhost:18080
FCT_APP_URL=http://localhost:18080
FCT_MAIL_FROM=no-reply@example.org
# Desarrollo: Mailpit expone SMTP en 1026 y su interfaz en http://localhost:8026.
FCT_MAIL_HOST=mailpit
FCT_MAIL_PORT=1025
FCT_MAIL_TRANSPORT=mailpit
FCT_MAIL_USERNAME=
FCT_MAIL_PASSWORD=
FCT_MAIL_ENCRYPTION=none
FCT_MAIL_FROM_NAME=Sistema FCT
# Producción: configure un secreto aleatorio y SMTP AUTH LOGIN sobre starttls o ssl.
FCT_RESET_RATE_LIMIT_KEY=replace-with-a-random-secret
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
