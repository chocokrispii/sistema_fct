# Entorno local de desarrollo con Docker Compose. Cambia estas claves antes de compartir el entorno.
# Si el puerto 8082 está ocupado, cambia PMA_PORT por otro puerto host disponible.
APP_PORT=8080
APP_ENV=development
# Solo omite el análisis durante desarrollo local; en otros entornos se rechaza.
FCT_CLAMAV_ENABLED=false
PMA_PORT=8082
FCT_DB_NAME=sistema_fct
FCT_DB_USER=fct
FCT_DB_PASS=fct_local_dev
MARIADB_ROOT_PASSWORD=root_local_dev
FCT_VITE_DEV_SERVER=
VITE_PORT=5173
FCT_APP_URL=http://localhost:8080
FCT_CONVENIO_SIGNATURE_MODE=mock
FCT_AUTOFIRMA_NSS_DIR=/var/lib/fct/autofirma-nssdb
FCT_AUTOFIRMA_NSS_PATH=./storage/autofirma-nssdb
FCT_CONVENIO_MOCK_P12_PASSWORD=
FCT_MATCH_DATE_TOLERANCE_DAYS=5
FCT_MATCH_MIN_OVERLAP_DAYS=1
FCT_MATCH_MIN_PRACTICE_DAYS=1
FCT_MATCH_MIN_SCHEDULE_PERCENT=80
FCT_INTEGRATIONS_ENABLED=false
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
FCT_WEBHOOK_ENCRYPTION_KEY=
FCT_MAIL_HOST=mailpit
FCT_MAIL_PORT=1025
FCT_MAIL_ENCRYPTION=none
FCT_MAIL_TRANSPORT=mailpit
FCT_MAIL_USERNAME=
FCT_MAIL_PASSWORD=
FCT_MAIL_FROM=noreply@example.test
FCT_MAIL_FROM_NAME=Sistema FCT
MAILPIT_WEB_PORT=8025
