{
  "name": "sistema-fct-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend progresivo Vue 3 y TypeScript integrado con el MVC PHP del Sistema FCT.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run build",
    "docs:dev": "vitepress dev docs_md",
    "docs:build": "vitepress build docs_md",
    "docs:preview": "vitepress preview docs_md"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.6.1",
    "debug": "^4.4.3",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.31",
    "postcss-nested": "^9.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "katex": "0.18.2",
    "vitepress": {
      "vite": "6.4.4"
    }
  }
}
