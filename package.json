{
  "name": "sistema-fct-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend progresivo Vue 3 y TypeScript integrado con el MVC PHP del Sistema FCT.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint frontend/src --max-warnings=0",
    "test": "npm run lint && npm run typecheck && npm run build && npm run docs:build && node scripts/test-suite.mjs",
    "check": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.6.1",
    "debug": "^4.4.3",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.31",
    "postcss-nested": "^9.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.0"
  }
}
