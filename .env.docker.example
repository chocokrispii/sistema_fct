# Configuración local de Docker; cambia las contraseñas antes de compartir el entorno.
# Si el puerto 8082 está ocupado, cambia PMA_PORT por otro puerto host disponible.
APP_PORT=8080
APP_ENV=development
# Solo omite el análisis durante desarrollo local; en otros entornos se rechaza.
FCT_CLAMAV_ENABLED=false
PMA_PORT=8082
FCT_DB_NAME=sistema_fct
FCT_DB_USER=fct
FCT_DB_PASS=fct_local_dev
MARIADB_ROOT_PASSWORD=root_local_dev
FCT_VITE_DEV_SERVER=
VITE_PORT=5173
FCT_WEBHOOK_INBOUND_SECRET=
FCT_WEBHOOK_OUTBOUND_URL=
FCT_WEBHOOK_OUTBOUND_SECRET=
