Options -Indexes
Require all granted
LimitRequestBody 12582912
php_value upload_max_filesize 10M
php_value post_max_size 12M
php_value max_file_uploads 1
php_value max_input_time 60
php_flag display_errors Off

RewriteEngine On
RewriteBase /
RewriteRule ^registro-empresa/?$ /index.php?action=registro-empresa [QSA,L]
RewriteRule ^admin/convenios/?$ /index.php?action=admin-convenios [QSA,R=302,L]
RewriteRule ^admin/solicitudes-password/?$ /index.php?action=admin-solicitudes-password [QSA,R=302,L]
RewriteRule ^api/public/empresas/registro/?$ /index.php?action=api-registro-empresa [L]
RewriteRule ^api/public/empresas/solicitud/?$ /index.php?action=api-registro-empresa [L]
RewriteRule ^api/admin/empresas/([1-9][0-9]*)/aprobar/?$ /index.php?action=api-aprobar-empresa&id=$1 [L]
RewriteRule ^api/admin/empresas/([1-9][0-9]*)/aprobar-convenio/?$ /index.php?action=api-aprobar-empresa&id=$1 [L]
RewriteRule ^api/auth/solicitar-reset-password/?$ /index.php?action=api-solicitar-reset-password [L]
RewriteRule ^api/auth/confirmar-reset-password/?$ /index.php?action=api-confirmar-reset-password [L]
RewriteRule ^api/admin/solicitudes-password/([1-9][0-9]*)/aprobar/?$ /index.php?action=api-aprobar-reset-password&id=$1 [L]
RewriteRule ^api/admin/solicitudes-password/([1-9][0-9]*)/rechazar/?$ /index.php?action=api-rechazar-reset-password&id=$1 [L]
RewriteRule ^restablecer-password/?$ /index.php?action=restablecer [QSA,L]
RewriteRule ^solicitud-pendiente/?$ /index.php?action=solicitud-pendiente [QSA,L]
RewriteRule ^dev/preview-publicar-oferta/?$ index.php?action=preview-publicar-oferta [QSA,L]
